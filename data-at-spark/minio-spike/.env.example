# MinIO spike overlay — LOCAL/TEST ONLY.
#
# Every value here is an example/local credential for a throwaway MinIO
# container on your own machine. Never reuse these values, and never point
# this overlay's MINIO_ENDPOINT/host_name config at a real S3 or R2 endpoint.

MINIO_IMAGE_VERSION=RELEASE.2025-09-07T16-13-09Z
MINIO_MC_IMAGE_VERSION=RELEASE.2025-08-13T08-35-41Z

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET_NAME=data-at-spark-local-test
MINIO_REGION=us-east-1

# ckan.plugins for this overlay only: the data-at-spark default plugin list
# (see data-at-spark/.env.example) plus s3filestore.
DATA_AT_SPARK_CKAN_PLUGINS_WITH_S3FILESTORE=image_view text_view datatables_view datastore datapusher envvars spark s3filestore

S3FILESTORE_SIGNED_URL_EXPIRY=60
