#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
PROJECT_DIR="$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)"

cd "$PROJECT_DIR"

if [ ! -f .env ]; then
  echo "Missing .env. Copy .env.example to .env and set production values first." >&2
  exit 1
fi

docker compose ps --status running >/dev/null

status_json="$(docker compose exec -T ckan wget -qO- http://localhost:5000/api/action/status_show)"
printf '%s' "$status_json" | grep -q '"success": true'
printf '%s' "$status_json" | grep -q '"datahub_branding"'
printf '%s' "$status_json" | grep -Eq '"site_title" ?: ?"DataHub Open Data"'

docker compose exec -T ckan wget -qO- http://localhost:5000/catalog.ttl | grep -q "dcat:Catalog"

docker compose exec -T ckan python - <<'PY'
import os
import sys
import urllib.request
from urllib.parse import urlparse

from rdflib import Graph, URIRef, Literal
from rdflib.namespace import DCTERMS, FOAF, RDF

DCAT = URIRef("http://www.w3.org/ns/dcat#")
LEG = URIRef("https://data.gov.sk/def/ontology/legislation/")


def term(namespace, name):
    return URIRef(str(namespace) + name)


def add_missing(failures, subject, predicate_name):
    failures.append(f"{subject} is missing {predicate_name}.")


def report_failures(failures):
    print("DCAT-AP-SK RDF validation failed:", file=sys.stderr)
    for failure in failures:
        print(f"- {failure}", file=sys.stderr)


def format_values(values):
    return "{" + ", ".join(sorted(value.n3() for value in values)) + "}"


def path_ends_with(value, suffix):
    path = urlparse(str(value).strip().lower()).path.rstrip("/")
    return path.endswith(suffix)


def value_is_csv_format(value, default_format, default_media_type):
    value_text = str(value).strip().lower()
    return value_text in {
        "csv",
        "text/csv",
        str(default_format).lower(),
        str(default_media_type).lower(),
    }


def is_csv_distribution(graph, distribution, default_format, default_media_type):
    url_values = list(graph.objects(distribution, term(DCAT, "accessURL")))
    url_values.extend(graph.objects(distribution, term(DCAT, "downloadURL")))
    if any(path_ends_with(value, ".csv") for value in url_values):
        return True

    non_csv_suffixes = (
        ".json",
        ".xml",
        ".rdf",
        ".ttl",
        ".nt",
        ".xlsx",
        ".xls",
        ".zip",
        ".txt",
    )
    if any(
        path_ends_with(value, suffix)
        for value in url_values
        for suffix in non_csv_suffixes
    ):
        return False

    format_or_media_values = list(graph.objects(distribution, DCTERMS.format))
    format_or_media_values.extend(graph.objects(distribution, term(DCAT, "mediaType")))
    return any(
        value_is_csv_format(value, default_format, default_media_type)
        for value in format_or_media_values
    )


def verify_non_csv_regression_guard(failures, default_format, default_media_type):
    graph = Graph()
    distribution = URIRef("urn:datahub:verify:json-distribution")
    json_url = URIRef("https://example.gov.sk/data.json")
    graph.add((distribution, term(DCAT, "accessURL"), json_url))
    graph.add((distribution, term(DCAT, "downloadURL"), json_url))
    graph.add((distribution, DCTERMS.format, default_format))
    graph.add((distribution, term(DCAT, "mediaType"), default_media_type))

    if is_csv_distribution(graph, distribution, default_format, default_media_type):
        failures.append(
            "Non-CSV distribution regression failed: .json URL must not be "
            "classified as CSV only because CSV default values are present."
        )


failures = []

publisher_uri = os.environ.get("DATAHUB_DCAT_PUBLISHER_URI")
publisher_name = os.environ.get("DATAHUB_DCAT_PUBLISHER_NAME")
default_format_uri = os.environ.get("DATAHUB_DCAT_DEFAULT_FORMAT_URI")
default_media_type_uri = os.environ.get("DATAHUB_DCAT_DEFAULT_MEDIA_TYPE_URI")
terms_authors_work_type_uri = os.environ.get("DATAHUB_DCAT_TERMS_AUTHORS_WORK_TYPE")
terms_original_database_type_uri = os.environ.get(
    "DATAHUB_DCAT_TERMS_ORIGINAL_DATABASE_TYPE"
)
terms_database_protected_by_special_rights_type_uri = os.environ.get(
    "DATAHUB_DCAT_TERMS_DATABASE_PROTECTED_BY_SPECIAL_RIGHTS_TYPE"
)
terms_personal_data_containment_type_uri = os.environ.get(
    "DATAHUB_DCAT_TERMS_PERSONAL_DATA_CONTAINMENT_TYPE"
)

if not publisher_uri:
    failures.append("Missing DATAHUB_DCAT_PUBLISHER_URI.")
if not publisher_name:
    failures.append("Missing DATAHUB_DCAT_PUBLISHER_NAME.")
if not default_format_uri:
    failures.append("Missing DATAHUB_DCAT_DEFAULT_FORMAT_URI.")
if not default_media_type_uri:
    failures.append("Missing DATAHUB_DCAT_DEFAULT_MEDIA_TYPE_URI.")
if not terms_authors_work_type_uri:
    failures.append("Missing DATAHUB_DCAT_TERMS_AUTHORS_WORK_TYPE.")
if not terms_original_database_type_uri:
    failures.append("Missing DATAHUB_DCAT_TERMS_ORIGINAL_DATABASE_TYPE.")
if not terms_database_protected_by_special_rights_type_uri:
    failures.append(
        "Missing DATAHUB_DCAT_TERMS_DATABASE_PROTECTED_BY_SPECIAL_RIGHTS_TYPE."
    )
if not terms_personal_data_containment_type_uri:
    failures.append("Missing DATAHUB_DCAT_TERMS_PERSONAL_DATA_CONTAINMENT_TYPE.")

if failures:
    report_failures(failures)
    sys.exit(1)

publisher = URIRef(publisher_uri)
default_format = URIRef(default_format_uri)
default_media_type = URIRef(default_media_type_uri)
terms_authors_work_type = URIRef(terms_authors_work_type_uri)
terms_original_database_type = URIRef(terms_original_database_type_uri)
terms_database_protected_by_special_rights_type = URIRef(
    terms_database_protected_by_special_rights_type_uri
)
terms_personal_data_containment_type = URIRef(terms_personal_data_containment_type_uri)

verify_non_csv_regression_guard(failures, default_format, default_media_type)

graph = Graph()
try:
    with urllib.request.urlopen("http://localhost:5000/catalog.ttl") as response:
        graph.parse(data=response.read(), format="turtle")
except Exception as exc:
    failures.append(f"Unable to fetch or parse catalog.ttl: {exc}")
    report_failures(failures)
    sys.exit(1)

catalogs = list(graph.subjects(RDF.type, term(DCAT, "Catalog")))
if not catalogs:
    failures.append("No dcat:Catalog found.")

for catalog in catalogs:
    catalog_publishers = set(graph.objects(catalog, DCTERMS.publisher))
    expected_publishers = {publisher}
    if catalog_publishers != expected_publishers:
        failures.append(
            f"{catalog} dct:publisher must exactly match "
            f"expected {format_values(expected_publishers)}, "
            f"actual {format_values(catalog_publishers)}."
        )

if (publisher, RDF.type, FOAF.Agent) not in graph:
    failures.append("Publisher URI is missing rdf:type foaf:Agent.")
publisher_names = set(graph.objects(publisher, FOAF.name))
expected_publisher_names = {Literal(publisher_name)}
if publisher_names != expected_publisher_names:
    failures.append(
        "Publisher URI foaf:name must exactly equal DATAHUB_DCAT_PUBLISHER_NAME; "
        f"expected {format_values(expected_publisher_names)}, "
        f"actual {format_values(publisher_names)}."
    )

datasets = list(graph.subjects(RDF.type, term(DCAT, "Dataset")))
if not datasets:
    failures.append("No dcat:Dataset found.")

for dataset in datasets:
    required_dataset_predicates = [
        (DCTERMS.publisher, "dct:publisher"),
        (term(DCAT, "theme"), "dcat:theme"),
        (DCTERMS.accrualPeriodicity, "dct:accrualPeriodicity"),
        (term(DCAT, "keyword"), "dcat:keyword"),
        (term(DCAT, "distribution"), "dcat:distribution"),
    ]
    for predicate, predicate_name in required_dataset_predicates:
        if not list(graph.objects(dataset, predicate)):
            add_missing(failures, dataset, predicate_name)
    dataset_publishers = set(graph.objects(dataset, DCTERMS.publisher))
    expected_publishers = {publisher}
    if dataset_publishers != expected_publishers:
        failures.append(
            f"{dataset} dct:publisher must exactly match "
            f"expected {format_values(expected_publishers)}, "
            f"actual {format_values(dataset_publishers)}."
        )

distributions = list(graph.subjects(RDF.type, term(DCAT, "Distribution")))
if not distributions:
    failures.append("No dcat:Distribution found.")

for distribution in distributions:
    required_distribution_predicates = [
        (term(DCAT, "accessURL"), "dcat:accessURL"),
        (term(DCAT, "downloadURL"), "dcat:downloadURL"),
        (DCTERMS.format, "dct:format"),
        (term(DCAT, "mediaType"), "dcat:mediaType"),
        (term(LEG, "termsOfUse"), "leg:termsOfUse"),
    ]
    for predicate, predicate_name in required_distribution_predicates:
        if not list(graph.objects(distribution, predicate)):
            add_missing(failures, distribution, predicate_name)

    distribution_formats = set(graph.objects(distribution, DCTERMS.format))
    distribution_media_types = set(graph.objects(distribution, term(DCAT, "mediaType")))
    expected_formats = {default_format}
    expected_media_types = {default_media_type}

    if is_csv_distribution(graph, distribution, default_format, default_media_type):
        if distribution_formats != expected_formats:
            failures.append(
                f"{distribution} CSV dct:format must exactly match "
                f"expected {format_values(expected_formats)}, "
                f"actual {format_values(distribution_formats)}."
            )
        if distribution_media_types != expected_media_types:
            failures.append(
                f"{distribution} CSV dcat:mediaType must exactly match "
                f"expected {format_values(expected_media_types)}, "
                f"actual {format_values(distribution_media_types)}."
            )
    else:
        if default_format in distribution_formats:
            failures.append(
                f"{distribution} non-CSV dct:format must not equal "
                "DATAHUB_DCAT_DEFAULT_FORMAT_URI."
            )
        if default_media_type in distribution_media_types:
            failures.append(
                f"{distribution} non-CSV dcat:mediaType must not equal "
                "DATAHUB_DCAT_DEFAULT_MEDIA_TYPE_URI."
            )

    if (distribution, DCTERMS.format, Literal("CSV")) in graph:
        failures.append(f'{distribution} keeps literal dct:format "CSV".')
    if (distribution, term(DCAT, "mediaType"), Literal("text/csv")) in graph:
        failures.append(f'{distribution} keeps literal dcat:mediaType "text/csv".')

    for terms_of_use in graph.objects(distribution, term(LEG, "termsOfUse")):
        if (terms_of_use, RDF.type, term(LEG, "TermsOfUse")) not in graph:
            add_missing(failures, terms_of_use, "rdf:type leg:TermsOfUse")

        exact_terms_predicates = [
            (
                term(LEG, "authorsWorkType"),
                "leg:authorsWorkType",
                terms_authors_work_type,
            ),
            (
                term(LEG, "originalDatabaseType"),
                "leg:originalDatabaseType",
                terms_original_database_type,
            ),
            (
                term(LEG, "databaseProtectedBySpecialRightsType"),
                "leg:databaseProtectedBySpecialRightsType",
                terms_database_protected_by_special_rights_type,
            ),
            (
                term(LEG, "personalDataContainmentType"),
                "leg:personalDataContainmentType",
                terms_personal_data_containment_type,
            ),
        ]
        for predicate, predicate_name, expected_object in exact_terms_predicates:
            actual_objects = set(graph.objects(terms_of_use, predicate))
            expected_objects = {expected_object}
            if actual_objects != expected_objects:
                failures.append(
                    f"{terms_of_use} {predicate_name} must exactly match "
                    f"expected {format_values(expected_objects)}, "
                    f"actual {format_values(actual_objects)}."
                )

if failures:
    report_failures(failures)
    sys.exit(1)

print("DCAT-AP-SK RDF validation passed.")
PY

docker compose exec -T ckan sh -c "grep -Eq '^ckan.site_url ?= ?' /srv/app/ckan.ini"
docker compose exec -T ckan sh -c "grep -Eq '^ckan.site_title ?= ?DataHub Open Data$' /srv/app/ckan.ini"
docker compose exec -T ckan sh -c "grep -Eq '^ckan.site_description ?= ?Katalog otvorenych dat$' /srv/app/ckan.ini"
docker compose exec -T ckan sh -c "grep -Eq '^ckan.uploads_enabled ?= ?true$' /srv/app/ckan.ini"
docker compose exec -T ckan sh -c "grep -Eq '^ckan.locale_default ?= ?sk$' /srv/app/ckan.ini"
docker compose exec -T ckan sh -c "grep -Eq '^scheming.dataset_schemas ?= ?ckanext.idsk:schemas/dcat_ap_sk.yaml$' /srv/app/ckan.ini"
docker compose exec -T ckan sh -c "grep -Eq '^ckanext.dcat.rdf.profiles ?= ?euro_dcat_ap_2 euro_dcat_ap_scheming datahub_dcat_ap_sk$' /srv/app/ckan.ini"

home_html="$(docker compose exec -T ckan wget -qO- http://localhost:5000)"
printf '%s' "$home_html" | grep -q "DataHub Open Data"
printf '%s' "$home_html" | grep -q "Open Data"
printf '%s' "$home_html" | grep -q "Vitajte v Open Data"
if printf '%s' "$home_html" | grep -Eq "Vitajte v CKAN|Welcome to CKAN|This is a nice introductory paragraph about CKAN|/base/images/ckan-logo.png|ckan-footer-logo|Powered by CKAN|CKAN API|CKAN Association"; then
  echo "Visible CKAN branding is still present on the homepage." >&2
  exit 1
fi

site_url="$(docker compose exec -T ckan sh -c "grep -E '^ckan.site_url ?= ?' /srv/app/ckan.ini | sed -E 's/^ckan.site_url ?= ?//'")"
echo "CKAN site URL: $site_url"

if [ "$site_url" = "https://CHANGE-ME.example.sk" ] || [ "$site_url" = "http://localhost:5000" ]; then
  echo "Warning: CKAN_SITE_URL is not a final public HTTPS URL. Do not register LKOD until this is updated." >&2
fi

echo "Production smoke check passed."
